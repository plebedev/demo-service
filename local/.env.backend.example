APP_NAME="Backend API"
ENVIRONMENT=local
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
DATABASE_URL=postgresql+psycopg://demo_service:demo_service@127.0.0.1:5432/demo_service
DB_DSN=
DB_USER=
DB_PASSWORD=
RUN_MIGRATIONS_ON_STARTUP=false
ACCESS_TOKEN_SIGNING_KEY=demo-phase1-change-me
ACCESS_TOKEN_TTL_SECONDS=604800
ADMIN_API_SECRET=demo-admin-change-me
DEFAULT_WORKFLOW_KEY=messy-notes-v1
# To use the local fine-tuned SLM served by Ollama, set:
# DEFAULT_WORKFLOW_KEY=messy-notes-local-slm
WORKFLOW_CONFIG_DIR=app/resources/workflows
POST_PROCESSOR_CONFIG_PATH=app/resources/post_processors/post-processors.yaml
CONTEXT_ENGINE_MODEL_CONFIG_PATH=app/resources/context_engine/model-flows.yaml
CONTEXT_ENGINE_EXECUTION_MODE=hybrid
MAX_FILES_PER_RUN=3
MAX_FILE_SIZE_BYTES=5242880
MAX_EXTRACTED_TEXT_BYTES=250000
MAX_TOTAL_WORKFLOW_TEXT_BYTES=400000
RAG_ORACLE_CHUNKING_PROVIDER=oracle
TEXT_TOOLS_ENABLED=true
TEXT_TOOLS_BASE_URL=http://127.0.0.1:8081
TEXT_TOOLS_TIMEOUT_SECONDS=2
EMAIL_PROVIDER=stub
INVITE_EMAIL_FROM=
INVITE_EMAIL_REPLY_TO=
INVITE_EMAIL_BASE_URL=http://localhost:3000
INVITE_EMAIL_DRAFT_PROVIDER=openai
INVITE_EMAIL_DRAFT_MODEL=gpt-5-mini
INVITE_EMAIL_BCC_ADDRESS=
OCI_EMAIL_SMTP_HOST=
OCI_EMAIL_SMTP_PORT=587
OCI_EMAIL_SMTP_USERNAME=
OCI_EMAIL_SMTP_PASSWORD=
OCI_EMAIL_FROM_ADDRESS=
OCI_EMAIL_FROM_NAME=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SMS_NOTIFICATION_ENABLED=false
SMS_REPLY_PROVIDER=openai
SMS_REPLY_MODEL=gpt-5-mini
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_API_KEY=ollama
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
FIREWORKS_API_KEY=
OPENROUTER_API_KEY=
XAI_API_KEY=
VOICE_PROVIDER=xai
VOICE_XAI_MODEL=grok-voice-think-fast-1.0
VOICE_GREETING_PROVIDER=openai
VOICE_GREETING_MODEL=gpt-4o-mini
